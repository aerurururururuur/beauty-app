# 服务监听
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info

# 数据目录(任务记录 + 输入/产物文件都在这下面)
DATA_DIR=./data

# 上妆引擎: mock | (未来) parametric | third-party
MAKEUP_ENGINE=mock

# 场景理解没有开关:妆容方向是 shared/domain/scene-rules.ts 的纯查表函数,
# 由流水线直接调用,没有可换的实现(2026-09-10 删掉了 understanding 模块与其 SCENE_ANALYZER)。

# 参考图来源: mock | off
REFERENCE_PROVIDER=mock

# 天气源: open-meteo(无 key 实拉,缺省) | mock(离线示意兜底)
# 现场断网演示前改成 mock,否则 /api/weather 会回 502 让前端回落手动填写
WEATHER_PROVIDER=open-meteo

# 上传大小上限(MB)
MAX_UPLOAD_MB=25


