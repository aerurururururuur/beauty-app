# 服务监听
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info

# 数据目录(任务记录 + 输入/产物文件都在这下面)
DATA_DIR=./data

# 上妆引擎: mock | (未来) parametric | third-party
MAKEUP_ENGINE=mock

# 场景理解没有开关:妆容方向是 shared/domain/scene-rules.ts 的纯查表函数,
# 由流水线直接调用,没有可换的实现(2026-09-10 删掉了 understanding 模块与其 SCENE_ANALYZER)。

# 参考图来源: mock(离线兜底,给不出图片地址) | off(不检索,空列表) | bing(外部检索)
# 缺省 mock:不联网、启动即用。要用真实检索显式改 bing。
# ★ bing 抓取失败会**降级为空列表**,不会让任务失败 —— 但每个任务会多 5 次网络往返。
REFERENCE_PROVIDER=mock
# 检索站点基址(仅 REFERENCE_PROVIDER=bing 用)。
# 之所以做成配置:部署环境(如魔搭创空间)的出站策略与本机不同,换站点/镜像/自建代理不该改代码。
# 缺省 https://cn.bing.com —— Bing 中国版,大陆可直连(Google / Pinterest 实测均不可达)。
REFERENCE_BASE_URL=https://cn.bing.com
# 检索超时毫秒(仅 bing 用)。参考图是增强项,超时宁可空着走完流水线。
REFERENCE_TIMEOUT_MS=5000

# 天气源: open-meteo(无 key 实拉,缺省) | mock(离线示意兜底)
# 现场断网演示前改成 mock,否则 /api/weather 会回 502 让前端回落手动填写
WEATHER_PROVIDER=open-meteo

# 上传大小上限(MB)
MAX_UPLOAD_MB=25


