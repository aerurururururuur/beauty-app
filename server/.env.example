# 场合美妆镜 · 后端配置
#
# ★ 总原则:**花钱的开关缺省一律选不产生账单的那个**(AGENT_LLM / MAKEUP_ENGINE 缺省都是 mock)。
#   只填 key、不改开关等于什么都没发生;改了开关才会用到 key 和钱。
#   三种运行形态(离线 / 真对话假图 / 全真)见 server/README.md。
# ★ 开关**取值**写错,服务起不来(启动即失败,报错会列出合法取值),不会静默回落。

# ── 服务监听 ────────────────────────────────────────────────────────────────
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info
# 任务记录 + 输入 / 产物文件都在这下面
DATA_DIR=./data

# ── 上妆引擎 ────────────────────────────────────────────────────────────────
# mock(离线骨架,缺省) | image(真实出图,按次计费) | replay(回放录制夹具,不联网)
MAKEUP_ENGINE=mock
#   image  → ★ 表单路径 POST /api/jobs **不可用**(真实引擎需要妆面单 LookSpec,表单不传它)。
#            引擎会明确报错;能出真图的只有对话 agent 那条路。
#   replay → 必须同时设 MAKEUP_FIXTURES_DIR 且目录里有对应夹具;没录过会明确报错,不给假图。
#   mock   → 演示 / CI / 单测用,永不因引擎崩掉。

# 录制夹具目录(绝对路径)。不设就不录(mock 忽略它)。里面是 <key>.json + <key>.png。
# ⚠️ 绝不要指到 DATA_DIR/engine-out:agent 收编成品图后会删掉引擎那份中间产物,
#    而 replay 的"产物"正在那个目录里 —— 指过去等于把花钱录的夹具自己删掉。
# MAKEUP_FIXTURES_DIR=/abs/path/to/server/src/modules/makeup/infrastructure/engine/__fixtures__

# ── 参考图检索 ──────────────────────────────────────────────────────────────
# mock(离线兜底,缺省) | live(外部检索)
REFERENCE_PROVIDER=mock
# 以下两项仅 live 用。缺省 Bing 中国版:大陆可直连(Google / Pinterest 实测均不可达)。
REFERENCE_BASE_URL=https://cn.bing.com
# 参考图是增强项:抓取失败降级为空列表、不会让任务失败,超时也宁可空着走完流水线。
REFERENCE_TIMEOUT_MS=5000

# ── 天气 ────────────────────────────────────────────────────────────────────
# live(无 key 实拉,缺省) | mock(离线示意兜底)
# ★ 断网演示前改成 mock,否则 /api/weather 回 502,前端回落手动填写。
WEATHER_PROVIDER=live

# 上传大小上限(MB)。框架级超限保留 413,不走项目的错误体,前端两种都要认。
MAX_UPLOAD_MB=25

# ── 对话 agent ──────────────────────────────────────────────────────────────
# mock(缺省,不联网不花钱) | real(真实模型,按 token 计费)
# ★ mock 是**一段脚本,不是模型**:它按固定规则演一遍流程,离线也能走完(含出图确认框)。
#   但它理解不了用户的话,也写不出 brief 里的结构化字段 —— 不能拿它判断妆面质量。
AGENT_LLM=mock
# 实测候选(qwen-flash / qwen-plus / qwen-max)见 scripts/probe-tool-calling.ts。
AGENT_MODEL=qwen-flash
# 缺省由 DASHSCOPE_API_HOST + /compatible-mode/v1 拼出,一般不用改;走自建代理 / 网关才设。
# AGENT_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 单会话最多出几张图。缺省 3;0 = 不限制(慎用 —— 出图确认就再没有兜底了)。
# AGENT_MAX_RENDERS=3
# 会话空闲多少小时算过期,到期**真删**照片与成品图。缺省 24。
# AGENT_SESSION_TTL_HOURS=24

# ── 产品库 ──────────────────────────────────────────────────────────────────
# 妆容聊定后 agent 推荐产品用的品牌资料。生成物:`npm run import-products` 从源 docx 产出,已进 git。
# 缺省指到仓库里那份,开箱即有。
# PRODUCTS_DIR=../products/ysl-property
#   两种指法:指到具体库(上面这样),或指到容器(../products)让它取下面唯一的库;
#   容器里有多个库时**启动即失败**,要求指明一个。
# ★ 指向不存在的路径 = **关掉产品库**(工具不注册,其余链路一点不变)。
# ⚠️ 内容坏了(JSON 语法错 / 字段缺 / category 与目录对不上)**一律启动即失败**,不静默跳过;
#   源资料自身的数据债原样入库,启动时 warn 一行摘要,详单见 products/<库>/library.json 的 health。

# ── 阿里云百炼 / DashScope ──────────────────────────────────────────────────
# ★ 服务运行路径读了这三项:AGENT_LLM=real 走它调对话模型,MAKEUP_ENGINE=image 走它出图。
#   同一个 key、同一个域名开关,不分别配置。
# Key 在 https://bailian.console.aliyun.com 建;华北2(北京)与新加坡的 Key **不通用**。
DASHSCOPE_API_KEY=
# 换业务空间专属域名(更高稳定性)可改成 https://{WorkspaceId}.cn-beijing.maas.aliyuncs.com
DASHSCOPE_API_HOST=https://dashscope.aliyuncs.com
# qwen-image-edit-plus 支持自定义 size 与 1-6 张输出;无后缀的 qwen-image-edit 只出一张。
QWEN_IMAGE_MODEL=qwen-image-edit-plus
