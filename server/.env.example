# 服务监听
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info

# 数据目录(任务记录 + 输入/产物文件都在这下面)
DATA_DIR=./data

# ── 上妆引擎(§5.4 / §8.1)───────────────────────────────────────────────────
# mock(离线骨架,缺省) | image(真实出图,按次计费) | replay(回放录制夹具,不联网)
# ★ 缺省 mock:与 AGENT_LLM 同一条规矩 —— 缺省值必须是"不会意外产生账单"的那个。
# ★ 这里**刻意没有 off** —— 没有引擎就出不了成品,给个 off 只会得到又一个假开关。
# ⚠️ 三个取值各有后果,别只看名字:
#   image  → 表单路径(POST /api/jobs)**不可用**:真实引擎需要妆面单(LookSpec),
#            而表单不传它。引擎会明确报错,不会瞎编一套妆。只有对话 agent 路径能走。
#   replay → **必须**同时设 MAKEUP_FIXTURES_DIR,且目录里要有对应的夹具;
#            未录制会明确报错(不静默给假图 —— 那会让 CI 全绿地骗人)。
#   mock   → 演示/CI/单测用这个,永不因引擎崩掉。
MAKEUP_ENGINE=mock
# 录制夹具目录(绝对路径)。**不设就不录**(缺省无副作用:这里的副作用是写盘)。
# 只对 image(录)与 replay(放)有意义;mock 会忽略它。里面是 <key>.json + <key>.png。
# ⚠️ **绝不要指到引擎的输出目录(DATA_DIR/engine-out)**:agent 收编一张成品图之后会把引擎那份
#    中间产物删掉(隐私,见 session-artifacts.ts),而 replay 的"产物"就在那个目录里 ——
#    指过去就等于**把花钱录的夹具自己删掉**。
# MAKEUP_FIXTURES_DIR=/abs/path/to/server/src/modules/makeup/infrastructure/engine/__fixtures__



# 参考图来源: mock(离线兜底,给不出图片地址) | off(不检索,空列表) | bing(外部检索)
# 缺省 mock:不联网、启动即用。要用真实检索显式改 bing。
# ★ bing 抓取失败会**降级为空列表**,不会让任务失败 —— 但每个任务会多 5 次网络往返。
REFERENCE_PROVIDER=mock
# 检索站点基址(仅 REFERENCE_PROVIDER=bing 用)。
# 之所以做成配置:部署环境(如魔搭创空间)的出站策略与本机不同,换站点/镜像/自建代理不该改代码。
# 缺省 https://cn.bing.com —— Bing 中国版,大陆可直连(Google / Pinterest 实测均不可达)。
REFERENCE_BASE_URL=https://cn.bing.com
# 检索超时毫秒(仅 bing 用)。参考图是增强项,超时宁可空着走完流水线。
REFERENCE_TIMEOUT_MS=5000

# 天气源: open-meteo(无 key 实拉,缺省) | mock(离线示意兜底)
# 现场断网演示前改成 mock,否则 /api/weather 会回 502 让前端回落手动填写
WEATHER_PROVIDER=open-meteo

# 上传大小上限(MB)
MAX_UPLOAD_MB=25

# ── 对话 agent ──────────────────────────────────────────────────────────────
# mock(缺省) | dashscope(真实模型,按 token 计费)
# ★ 缺省是 mock 而**不是**实拉,与 WEATHER_PROVIDER 缺省 open-meteo 相反,理由是花钱:
#   天气实拉免费,模型调用计费。缺省值必须是"不会意外产生账单"的那个。
# ★ mock 是**一段脚本化演示,不是模型**:它按固定规则演一遍
#   「需求 → 妆面 → 照片 → 确认出图」,所以离线也能走完整套(含确认框),不联网、不花钱。
#   ⚠️ 它理解不了用户的话,也写不出 brief 里的结构化字段 —— 不能拿它判断妆面质量。
#   详见 server/README.md 的「对话 agent」一节。
# 离线演示 / CI / 单元测试一律留 mock。要用真模型就显式改 dashscope。
AGENT_LLM=mock
# 对话模型名。实测候选(qwen-flash / qwen-plus / qwen-max)见 scripts/probe-tool-calling.ts。
# qwen-flash 实测 847ms 能跑完整两轮工具调用,是这三档里最快的。
AGENT_MODEL=qwen-flash
# 端点基址。缺省由 DASHSCOPE_API_HOST + /compatible-mode/v1 拼出,一般不用改。
# 要走自建代理/网关时才显式设这一项。
# AGENT_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ── 对话 agent 的出图额度与会话寿命(阶段 3)────────────────────────────────
# 单会话最多出几张图(§10 [I3])。0 = 不限制。缺省 3。
# ★ 上限的理由不是省钱(一张才几分钱),是**防失控**:每一次出图都要用户点一次确认,
#   没有上限时模型可以一直要,用户点烦了就会开始闭眼点 —— 那时"每次确认"这道闸门就名存实亡了。
# AGENT_MAX_RENDERS=3
# 会话空闲多少小时算过期(§10 [I8])。缺省 24;到期**真删**照片与成品图(隐私红线)。
# ★ 它不是调优参数:它同时是"用户本人的照片在服务端最多留多久"这个承诺,
#   改大它等于改隐私条款。想让清理更勤是改扫描间隔(代码里的 PURGE_INTERVAL_MS),不是改这一项。
# AGENT_SESSION_TTL_HOURS=24

# ── 产品库(2026-09-16 起)───────────────────────────────────────────────────
# 妆容聊定之后 agent 推荐产品用的那份品牌资料。内容是**生成物**:
# 跑 `npm run import-products`(见 scripts/README.md)从源 docx 出来,放进 git。
#
# 目录层级是 库 → 类别 → 产品:`products/<库>/<类别>/<产品>.json`,库根有 library.json。
# 缺省指到仓库里那份(相对 server/ 的 cwd),开箱即有。
# PRODUCTS_DIR=../products/ysl-property
#
# ★ 两种指法都行:指到**具体的库**(上面这样),或者指到**容器**(`../products`)让它
#   自己取下面唯一的那个库。容器里有多个库时会**启动即失败**并要求指明一个 ——
#   随便挑一个的后果是模型只看得见其中一个品牌,而它自己不知道。
#
# ★ **指向一个不存在的路径 = 关掉产品库**:`list_products` / `read_product` 不注册,
#   模型看不到它们,其余链路一点不变。回归测试就靠这个。
#   ⚠️ 不是"注册了但返回空" —— 那是假开关,模型会对着空库编出像模像样的推荐。
#
# ⚠️ 目录在但**内容坏了**(JSON 语法错、字段缺、category 与目录对不上、类目登记条数与
#   实际不符)**一律启动即失败**,绝不静默跳过。静默丢产品 = 模型从残缺库里推荐而没人知道。
#   内容里的已知问题(源资料自身那些)是**原样入库**的,启动时会以 warn 打一行摘要,
#   详单在 `products/<库>/library.json` 的 health 字段。要修请改源文档后重跑导入器。

# ── 阿里云百炼 / DashScope ──────────────────────────────────────────────────
# ★ 这三项**服务运行路径全都读了**(2026-09-16 起):
#   AGENT_LLM=dashscope 时走它们调对话模型;MAKEUP_ENGINE=image 时走它们出图。
#   同一个 key、同一个域名开关,不分别配置。
#   (此前只给 scripts/qwen-image-makeup.ts 这个实验脚本用。)
# Key 在 https://bailian.console.aliyun.com 建;华北2(北京)与新加坡的 Key **不通用**。
DASHSCOPE_API_KEY=
# 端点基址。缺省老域名 dashscope.aliyuncs.com(文档称仍可用);
# 换业务空间专属域名(更高稳定性)就改成 https://{WorkspaceId}.cn-beijing.maas.aliyuncs.com。
DASHSCOPE_API_HOST=https://dashscope.aliyuncs.com
# 缺省模型。qwen-image-edit-plus:支持自定义 size 与 1-6 张输出;
# qwen-image-edit(无后缀)只出一张、且不认 size/prompt_extend。
QWEN_IMAGE_MODEL=qwen-image-edit-plus


