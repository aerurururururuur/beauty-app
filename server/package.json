{
  "name": "@beauty-app/server",
  "version": "0.1.0",
  "private": true,
  "description": "场合美妆后端 —— 模块化清洁架构:src/modules/* 按功能拆模块,模块内部 domain/application/presentation/infrastructure;模块间只走 public barrel",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "^11",
    "@fastify/multipart": "^9",
    "fastify": "^5",
    "zod": "^3.23"
  },
  "devDependencies": {
    "@types/node": "^22",
    "tsx": "^4",
    "typescript": "^5",
    "vitest": "^3"
  }
}
